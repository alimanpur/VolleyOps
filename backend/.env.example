# VolleyOps backend environment
# Copy to .env and fill in real values. Never commit .env.

# HTTP port the API listens on
PORT=4000

# Node environment: development | production
NODE_ENV=development

# MongoDB connection string (source of truth for the tournament)
# Local:   mongodb://127.0.0.1:27017/volleyops
# Atlas:   mongodb+srv://user:pass@cluster/volleyops
MONGODB_URI=mongodb://127.0.0.1:27017/volleyops

# Secret used to sign session cookies. Use a long random string in production.
SESSION_SECRET=change-me-to-a-long-random-string

# How long a session stays valid, in hours
SESSION_TTL_HOURS=12

# Comma-separated list of origins allowed to call the API with credentials
CORS_ORIGIN=http://localhost:5173

# Initial admin bootstrap (used by the seed script only)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=volleyops-admin

# Set to "true" to trust the first proxy hop (needed for secure cookies behind a proxy)
TRUST_PROXY=false
